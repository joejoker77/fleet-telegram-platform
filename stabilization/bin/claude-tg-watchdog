#!/usr/bin/env bash
# claude-tg-watchdog — Problem A/B safety net (M0 stabilization).
#
# Closes the gap that bit us repeatedly: the Telegram plugin is an MCP *child*
# of the main `claude` process. If that child dies (nested `claude` evicting the
# poll lock, ppid orphan-watchdog false positive, OOM of the child, etc.) while
# the parent `claude` (tmux session) stays alive, the unit remains "active" so
# systemd's Restart=always never fires — and the bot goes silent until a manual
# `systemctl restart`. The launcher's own loop only watches the tmux session,
# not the plugin, so it misses exactly this case.
#
# This watchdog watches what the plugin already maintains — its `bot.pid` — and
# restarts the unit when the poller is dead while the unit is active. It does
# NOT patch the official plugin and makes NO LLM calls. Pure liveness.
#
# Invoked by claude-tg-watchdog.timer (~every 20s). Runs as root.
set -uo pipefail

STARTUP_GRACE=90          # s: ignore a unit that (re)started recently — bot.pid
                          # may not be written yet, or a cutover is in progress.
LOG_TAG=claude-tg-watchdog

mono_now=$(awk '{print int($1)}' /proc/uptime)

systemctl list-units --type=service --state=active --no-legend 'claude-tg@*' \
  | awk '{print $1}' | while read -r unit; do
  [ -n "$unit" ] || continue
  user="${unit#claude-tg@}"; user="${user%.service}"
  pidfile="/home/$user/.claude/channels/telegram-$user/bot.pid"

  # Uptime grace via monotonic active-enter timestamp (microseconds since boot).
  aet=$(systemctl show "$unit" -p ActiveEnterTimestampMonotonic --value 2>/dev/null || echo 0)
  [ -n "$aet" ] || aet=0
  aet_s=$(( aet / 1000000 ))
  uptime_s=$(( mono_now - aet_s ))
  if [ "$uptime_s" -lt "$STARTUP_GRACE" ]; then
    continue
  fi

  healthy=0
  if [ -f "$pidfile" ]; then
    pid=$(cat "$pidfile" 2>/dev/null || echo "")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      healthy=1
    fi
  fi

  if [ "$healthy" != 1 ]; then
    logger -t "$LOG_TAG" "poller DOWN for ${user} (unit active ${uptime_s}s, pidfile=${pidfile}) — restarting ${unit}"
    systemctl restart "$unit"
  fi
done
