# M2.1 — user runtime image (one tenant per container).
# First-party Claude Code on the tenant's own subscription: NO ANTHROPIC_BASE_URL
# override (per ADR-001 — direct to api.anthropic.com, no LiteLLM/proxy).
# Tools land in system paths (/usr/*) so they work under --userns=keep-id where
# the runtime process is the tenant user, not root.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git tmux python3 unzip xz-utils socat jq \
 && rm -rf /var/lib/apt/lists/*

# Node 22 (NodeSource) — Claude Code + the official Telegram plugin's tooling.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Official Claude Code CLI.
RUN npm install -g @anthropic-ai/claude-code

# Bun — dependency of the official Telegram plugin. Install to /usr/local so it
# is on PATH and readable by any uid (not /root, which keep-id can't reach).
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash

# code-server — per-tenant web IDE (authoring; wired at M5).
RUN curl -fsSL https://code-server.dev/install.sh | sh

# M4.1 — shellfirm: dangerous-shell-command guard (kaplanelad/shellfirm v0.3.10).
# Native binary pinned to the same version the host fleet runs; the PreToolUse
# wrapper (which closes shellfirm's quoting-bypass) + the system policy are baked
# in. Per-user agent-mode config (~/.config/shellfirm) and the cwd-loaded
# ~/work/.shellfirm.yaml policy are seeded by the entrypoint. The wrapper needs jq.
RUN curl -fsSL -o /tmp/shellfirm.tar.xz \
      https://github.com/kaplanelad/shellfirm/releases/download/v0.3.10/shellfirm-v0.3.10-x86_64-linux.tar.xz \
 && tar -xJf /tmp/shellfirm.tar.xz --strip-components=1 -C /tmp \
 && install -m 0755 /tmp/shellfirm /usr/local/bin/shellfirm \
 && rm -f /tmp/shellfirm.tar.xz /tmp/shellfirm
COPY platform/shellfirm/shellfirm-bot-wrapper /usr/local/bin/shellfirm-bot-wrapper
RUN install -d /etc/shellfirm
COPY platform/shellfirm/policy.yaml /etc/shellfirm/policy.yaml
RUN chmod 0755 /usr/local/bin/shellfirm-bot-wrapper && chmod 0644 /etc/shellfirm/policy.yaml

# M4.1 — block-nested-claude PreToolUse guard: blocks any bare `claude` invocation
# (e.g. `claude mcp list`) that would boot a 2nd telegram plugin and evict this
# bot's poll lock. Pure-stdlib python3, no deps. Hook already wired in the tenant's
# mounted ~/.claude/settings.json (/usr/local/share/claude-guard/block-nested-claude.py).
RUN install -d /usr/local/share/claude-guard
COPY platform/claude-guard/block-nested-claude.py /usr/local/share/claude-guard/block-nested-claude.py
RUN chmod 0755 /usr/local/share/claude-guard/block-nested-claude.py

# M4 #3 — LOCKED platform settings layer. Claude Code reads managed-settings.json
# from the OS path /etc/claude-code/ at the HIGHEST precedence; it cannot be
# overridden or weakened by the tenant's writable ~/.claude/settings.json. /etc is
# a read-only image layer in the pod (uid 1005 can't write it), so the security
# hooks (shellfirm + block-nested-claude), the deny rules, and the metering Stop
# hook baked here are tamper-proof. Hooks merge additively with the tenant layer.
RUN install -d /etc/claude-code
COPY platform/managed-settings.json /etc/claude-code/managed-settings.json
RUN chmod 0644 /etc/claude-code/managed-settings.json

# Platform layer: entrypoint + metering hook + scaffold templates (the unused
# settings.platform.json template predates M4 #3; the live locked layer is the
# managed-settings.json above).
COPY platform/ /opt/platform/
RUN chmod 0755 /opt/platform/entrypoint.sh

# Sanity: fail the build early if a core tool is missing or the locked managed
# settings layer is malformed (a bad JSON here would silently disable enforcement).
RUN claude --version && bun --version && code-server --version && node --version \
 && shellfirm --version && jq --version \
 && jq -e . /etc/claude-code/managed-settings.json >/dev/null

ENTRYPOINT ["/opt/platform/entrypoint.sh"]
