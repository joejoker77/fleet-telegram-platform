# M2.1 — user runtime image (one tenant per container).
# First-party Claude Code on the tenant's own subscription: NO ANTHROPIC_BASE_URL
# override (per ADR-001 — direct to api.anthropic.com, no LiteLLM/proxy).
# Tools land in system paths (/usr/*) so they work under --userns=keep-id where
# the runtime process is the tenant user, not root.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git tmux python3 unzip xz-utils socat jq \
      openssh-client rsync \
 && rm -rf /var/lib/apt/lists/*

# Node 22 (NodeSource) — Claude Code + the official Telegram plugin's tooling.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Official Claude Code CLI — PINNED. Do NOT float to `latest`: claude 2.1.181
# ships an embedded Bun 1.4.0 "baseline" build whose JSC thread-suspend (TLC)
# path segfaults in the interactive TUI on our hosts ("panic: Segmentation
# fault", "embedder failed to suspend thread … for TLC"), restart-looping the
# pod. 2.1.177 is the version the entire live fleet runs without crashing. Bump
# this ARG only after validating the new version boots a polling bot.
ARG CLAUDE_VERSION=2.1.177
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_VERSION}"

# Bun — dependency of the official Telegram plugin. Install to /usr/local so it
# is on PATH and readable by any uid (not /root, which keep-id can't reach).
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash

# code-server — per-tenant web IDE (authoring; wired at M5).
RUN curl -fsSL https://code-server.dev/install.sh | sh

# Baseline tenant plugin — the official Telegram channel plugin, installed CLEAN
# from the official marketplace and baked into the image as a first-class
# dependency (Vitaliy: "the plugin must be in the deps from the start"). No
# per-tenant network install, no hand-patched server.ts. provision-tenant
# extracts this skeleton into each tenant's ~/.claude/plugins and rewrites the
# embedded absolute home paths (installed_plugins.json / known_marketplaces.json)
# for that tenant. node_modules is vendored here so the plugin's start-time
# `bun install` is an offline no-op inside the egress-locked pod.
ENV CLAUDE_SKEL=/opt/claude-skel
RUN mkdir -p "$CLAUDE_SKEL" \
 && HOME="$CLAUDE_SKEL" claude plugin marketplace add anthropics/claude-plugins-official </dev/null \
 && HOME="$CLAUDE_SKEL" claude plugin install telegram@claude-plugins-official --scope user </dev/null \
 && ( cd "$CLAUDE_SKEL"/.claude/plugins/cache/claude-plugins-official/telegram/*/ && bun install --no-summary ) \
 && HOME="$CLAUDE_SKEL" claude plugin list </dev/null | grep -q 'telegram@claude-plugins-official' \
 # provision writes the real tenant settings.json baseline; drop claude's auto-stub
 && rm -f "$CLAUDE_SKEL/.claude/settings.json" \
 # normalize the two index files' embedded build-home path to a placeholder
 && sed -i "s#$CLAUDE_SKEL#__TENANT_HOME__#g" \
      "$CLAUDE_SKEL/.claude/plugins/installed_plugins.json" \
      "$CLAUDE_SKEL/.claude/plugins/known_marketplaces.json"

# M4.1 — shellfirm: dangerous-shell-command guard (kaplanelad/shellfirm v0.3.10).
# Native binary pinned to the same version the host fleet runs; the PreToolUse
# wrapper (which closes shellfirm's quoting-bypass) + the system policy are baked
# in. Per-user agent-mode config (~/.config/shellfirm) and the cwd-loaded
# ~/work/.shellfirm.yaml policy are seeded by the entrypoint. The wrapper needs jq.
RUN curl -fsSL -o /tmp/shellfirm.tar.xz \
      https://github.com/kaplanelad/shellfirm/releases/download/v0.3.10/shellfirm-v0.3.10-x86_64-linux.tar.xz \
 && tar -xJf /tmp/shellfirm.tar.xz --strip-components=1 -C /tmp \
 && install -m 0755 /tmp/shellfirm /usr/local/bin/shellfirm \
 && rm -f /tmp/shellfirm.tar.xz /tmp/shellfirm
COPY platform/shellfirm/shellfirm-bot-wrapper /usr/local/bin/shellfirm-bot-wrapper
RUN install -d /etc/shellfirm
COPY platform/shellfirm/policy.yaml /etc/shellfirm/policy.yaml
RUN chmod 0755 /usr/local/bin/shellfirm-bot-wrapper && chmod 0644 /etc/shellfirm/policy.yaml

# M4.1 — block-nested-claude PreToolUse guard: blocks any bare `claude` invocation
# (e.g. `claude mcp list`) that would boot a 2nd telegram plugin and evict this
# bot's poll lock. Pure-stdlib python3, no deps. Hook already wired in the tenant's
# mounted ~/.claude/settings.json (/usr/local/share/claude-guard/block-nested-claude.py).
RUN install -d /usr/local/share/claude-guard
COPY platform/claude-guard/block-nested-claude.py /usr/local/share/claude-guard/block-nested-claude.py
RUN chmod 0755 /usr/local/share/claude-guard/block-nested-claude.py

# M4 #3 (REVERTED 2026-06-09) — the /etc/claude-code/managed-settings.json layer was
# removed. Verified in-pod on Claude Code 2.1.169: managed-layer HOOKS do NOT fire,
# and the managed deny list was a strict subset of the tenant deny (which adds
# Bash(sudo *) on top), so it added zero coverage while being a foot-gun (one
# unrecognized key silently voids the WHOLE managed file). Security lives in the
# tenant ~/.claude/settings.json — git HEAD is the source of truth, healed by
# agentshield-gate (git restore from HEAD on regression) + prestate-commit + alert.
# See platform/README.managed-settings.md for the full rationale.

# Platform layer: entrypoint + metering hook + scaffold templates. NOTE: the
# settings.platform.json template here is unused scaffold (predates M4 #3); the
# managed-settings.json locked layer was removed 2026-06-09 (see the tombstone
# README in platform/). Security lives in the tenant ~/.claude/settings.json.
COPY platform/ /opt/platform/
RUN chmod 0755 /opt/platform/entrypoint.sh /opt/platform/session-ctl /opt/platform/bin/* \
 && ln -sf /opt/platform/session-ctl /usr/local/bin/session-ctl \
 # M6.2: key-less Composio helpers (x-api-key injected by the OneCLI proxy)
 && ln -sf /opt/platform/bin/composio-connect /usr/local/bin/composio-connect \
 && ln -sf /opt/platform/bin/composio-session /usr/local/bin/composio-session \
 # M7.5: deterministic multi-account tool execution (account-aware execute path)
 && ln -sf /opt/platform/bin/composio-exec /usr/local/bin/composio-exec \
 # M7.5: host-root bridge for admins (inert unless make-admin.sh provisioned the key)
 && ln -sf /opt/platform/bin/host-sudo /usr/local/bin/host-sudo \
 # M8.1: pod-side GitHub publisher for the artifact marketplace (PAT injected by proxy)
 && ln -sf /opt/platform/bin/registry-publish /usr/local/bin/registry-publish \
 # B: rich-message / structured-reply helper the clean plugin's reply tool lacks
 && ln -sf /opt/platform/bin/tg-send /usr/local/bin/tg-send \
 # C: full-text search over this bot's own session logs (FTS5; indexer loop in entrypoint)
 && ln -sf /opt/platform/bin/session-search /usr/local/bin/session-search

# Sanity: fail the build early if a core tool is missing.
RUN claude --version && bun --version && code-server --version && node --version \
 && shellfirm --version && jq --version

ENTRYPOINT ["/opt/platform/entrypoint.sh"]
