#!/usr/bin/env bash
# composio-session — M6.2: create a Composio tool-router session for a user and
# print its MCP URL (the value to put in ~/work/.mcp.json as the `composio`
# http server). Replaces the prototype's static stanza + dead stdio bridge.
#
#   composio-session --user-id <telegram_chat_id> [--toolkits gmail,slack]
#
# KEY-LESS: runs in the pod; the OneCLI egress proxy injects the platform
# x-api-key for *.composio.dev (see m6.2-composio-vault.sh). The MCP URL it
# prints may live on backend.composio.dev or mcp.composio.dev — both hosts are
# covered by the vault bindings, so the MCP connection is key-less too.
#
# API (docs.composio.dev, checked 2026-06-12; multi-account 2026-06-16):
#   POST /api/v3.1/tool_router/session
#     {user_id, manage_connections:{enable},
#      multi_account:{enable,max_accounts_per_toolkit,require_explicit_selection}}
#   → {session_id, mcp:{type:"http", url}}
#
# MULTI-ACCOUNT (M7.5): we ALWAYS enable multi_account so a user can hold several
# accounts of one toolkit (e.g. work + personal Gmail). It's behaviour-preserving
# for single-account users — it only engages once a toolkit has >1 ACTIVE account.
# require_explicit_selection=true: with >1 account the agent MUST pass `account`
# (connected_account_id OR alias) on the tool call — so we never silently act on
# the wrong account; with one account nothing changes.
set -euo pipefail

BASE="https://backend.composio.dev"
UID_ARG="" TOOLKITS="" MAX_ACCT=5

while [ $# -gt 0 ]; do
  case "$1" in
    --user-id) UID_ARG="${2:-}"; shift 2;;
    --toolkits) TOOLKITS="${2:-}"; shift 2;;
    --max-accounts) MAX_ACCT="${2:-}"; shift 2;;
    -h|--help) sed -n '2,20p' "$0"; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done
case "$UID_ARG" in (*[!0-9]*|"") echo "ERROR: --user-id must be the numeric telegram chat_id" >&2; exit 2;; esac
case "$TOOLKITS" in (*[!a-zA-Z0-9_,-]*) echo "ERROR: --toolkits must be comma-separated slugs" >&2; exit 2;; esac
case "$MAX_ACCT" in (*[!0-9]*|"") echo "ERROR: --max-accounts must be an integer 2-10" >&2; exit 2;; esac
[ "$MAX_ACCT" -ge 2 ] && [ "$MAX_ACCT" -le 10 ] || { echo "ERROR: --max-accounts must be 2-10" >&2; exit 2; }

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

# manage_connections enabled → the session exposes the connection meta-tools
# (COMPOSIO_MANAGE_CONNECTIONS etc.) the bot's playbooks already rely on.
# multi_account always on (see header).
MA="$(jq -n --argjson max "$MAX_ACCT" \
  '{enable:true, max_accounts_per_toolkit:$max, require_explicit_selection:true}')"
if [ -n "$TOOLKITS" ]; then
  jq -n --arg uid "$UID_ARG" --arg tk "$TOOLKITS" --argjson ma "$MA" \
    '{user_id:$uid, toolkits:($tk|split(",")), manage_connections:{enable:true}, multi_account:$ma}' > "$TMP/req.json"
else
  jq -n --arg uid "$UID_ARG" --argjson ma "$MA" \
    '{user_id:$uid, manage_connections:{enable:true}, multi_account:$ma}' > "$TMP/req.json"
fi

HTTP="$(curl -sS -o "$TMP/sess.json" -w '%{http_code}' \
  -X POST "$BASE/api/v3.1/tool_router/session" \
  -H 'content-type: application/json' --data-binary @"$TMP/req.json")"
case "$HTTP" in (2*) :;; (*) echo "ERROR: tool_router/session HTTP $HTTP: $(cat "$TMP/sess.json")" >&2; exit 1;; esac

URL="$(jq -r '.mcp.url // empty' "$TMP/sess.json")"
SID="$(jq -r '.session_id // empty' "$TMP/sess.json")"
[ -n "$URL" ] || { echo "ERROR: no mcp.url in response: $(cat "$TMP/sess.json")" >&2; exit 1; }
echo "session_id=$SID" >&2
echo "$URL"
