#!/usr/bin/env bash
# host-sudo <command...> — run a command as root on the HOST (admins only, M7.5
# Model B). Connects over the ssh bridge using the admin key; the host side pins
# that key to host-sudo-broker (classify -> normal: sudo+audit / destructive: HITL),
# so this helper is just a thin client — the authoritative gate lives on the host.
#
# Present in every pod image, but inert unless the pod was made admin
# (make-admin.sh installs the key + host account + NOPASSWD sudo).
set -uo pipefail
[ "$#" -ge 1 ] || { echo "usage: host-sudo <command...>" >&2; exit 2; }

KEY="${HOST_ADMIN_KEY:-$HOME/.ssh/host-admin}"
[ -f "$KEY" ] || { echo "host-sudo: no admin key at $KEY — this assistant is not an admin." >&2; exit 4; }

# Host = the pod's default-route gateway (cl-net gateway). Override with CL_HOST_GW.
GW="${CL_HOST_GW:-}"
[ -n "$GW" ] || GW="$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}')"
[ -n "$GW" ] || { echo "host-sudo: cannot resolve host gateway (set CL_HOST_GW)" >&2; exit 5; }

# Host login user (the admin's own host account). Injected by make-admin via the
# pod, else falls back to the pod's user name.
HOSTUSER="${HOST_ADMIN_USER:-$(id -un 2>/dev/null)}"
[ -n "$HOSTUSER" ] || { echo "host-sudo: set HOST_ADMIN_USER" >&2; exit 5; }

# The full command travels to the broker as $SSH_ORIGINAL_COMMAND (one string).
exec ssh -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
  -o ConnectTimeout=10 "$HOSTUSER@$GW" "$*"
