{
  "permissions": {
    "deny": [
      "Bash(*> /dev/*)",
      "Bash(chmod 777 *)",
      "Bash(rm -rf *)",
      "Bash(ssh *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/usr/local/bin/shellfirm-bot-wrapper", "timeout": 10 },
          { "type": "command", "command": "/usr/local/share/claude-guard/block-nested-claude.py", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node /opt/platform/hooks/metering-stop-hook.mjs" }
        ]
      }
    ]
  }
}
