#!/usr/bin/python3
"""login-modal-watch — clear a sign-in window that is holding a bot hostage.

Claude Code's `/login` opens a MODAL in the bot's own terminal. Until a code is typed
into that same terminal, the session reads nothing else: every Telegram message queues
behind it and the bot goes silent. Nothing notices. The container is up, the poller is
up, the credentials may be perfectly valid, and no health check in the fleet looks at
what is actually on the screen. paul-young lost six hours to this on 2026-11-09 — his
key had been renewed at 09:36 and his bot stayed deaf until the window was closed by
hand at 12:45.

The window is legitimate when there is nothing to sign in with: a cold start, or a
genuinely expired account, where somebody must complete a sign-in. So this only acts
when the credentials on disk are VALID and the window has been sitting there past
GRACE_S anyway — which is not a sign-in in progress, it is a sign-in nobody is coming
to finish.

    login-modal-watch              look at every tenant, clear what is stuck
    login-modal-watch --dry-run    say what it would do, touch nothing
    login-modal-watch --only a b   just these tenants
    login-modal-watch --grace 300  override the dwell time (seconds)

Reports to the admin's Telegram, because the whole lesson of the day this was written
is that a thing which fixes itself quietly is a thing nobody knows was broken.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import pwd
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone

HOME_ROOT = os.environ.get("FLEET_HOME_ROOT", "/home")
STATE_DIR = "/var/lib/login-modal-watch"
GRACE_S = int(os.environ.get("LOGIN_MODAL_GRACE_S", "600"))
DEFAULT_ADMIN = os.environ.get("FLEET_EXPIRY_ADMIN", "tonysoprano1337")
SKIP = {"cplane"}
# The bot's own tmux session. Overridable so the detect/clear path can be exercised
# against a stand-in session instead of a real lawyer's bot.
TMUX_SESSION = os.environ.get("FLEET_TMUX_SESSION", "claude")

# The modal's own furniture. Both lines are Claude Code's, and neither appears in
# ordinary output; requiring either one alone would be enough, but a pane that scrolled
# half the modal away is not a pane we want to send keys at.
MODAL_MARKERS = ("Paste code here if prompted", "Browser didn't open?")

# A message from the person, sitting unread behind the modal. Claude Code renders a
# queued inbound channel message as "← telegram · <chat>: <text>". Its presence settles
# what we are looking at: nobody is quietly finishing a sign-in at the terminal while
# the owner of the bot is talking to it and getting nothing back.
QUEUED_MARKER = "← telegram"

# The sign-in the person was handed at the terminal cannot be rescued from here. The
# pane renders their pasted code elided ("WIs5…#BwjFJ…"), the full text never reaches
# us, and it is bound to the pane's own challenge anyway. What we can do is end the
# dead attempt and hand the sign-in to the route that does take a code from the chat.
RELOGIN_TRIGGER = "/usr/local/sbin/relogin-trigger"

# The pane is created 200x60. A client that attaches at 80 columns shrinks it for as
# long as it stays, and tmux keeps the smaller size after it goes. That is not cosmetic:
# the TUI elides a queued message at the pane width, so an 80-column pane turns the code
# we need into "WIs5…#BwjFJ…". paul-young's bot ran at 80x23 for six hours because a
# support session attached and never detached.
PANE_COLS, PANE_ROWS = 200, 60

# A sign-in code as it comes back from the callback page: one token, the code, '#', the
# state. Deliberately strict — it has to be told apart from the authorize URL sitting in
# the modal two lines above it, which is why '/', '=', '&' and '?' are excluded.
CODE_RE = re.compile(r"^[A-Za-z0-9_-]{16,}#[A-Za-z0-9_-]{8,}$")
# Claude Code's own mark for "there is more of this than fits".
ELLIPSIS = "\u2026"


def tenants() -> list[str]:
    found = []
    for path in sorted(glob.glob(f"{HOME_ROOT}/*/.claude/channels/telegram-*")):
        user = path.split("/")[2]
        if user not in SKIP and user not in found:
            found.append(user)
    return found


def run(argv: list[str], timeout: int = 30,
        inp: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, input=inp)


def in_pod(user: str, *argv: str, inp: str | None = None) -> subprocess.CompletedProcess:
    """Run something in a tenant's container as that tenant.

    By NUMBER, not by name. The host account and the container account share a uid but
    not always a name: the oldest pod on this host answers `--user dmitriirudenko` with
    "no matching entries in passwd file" because uid 1000 is called `ubuntu` in there.
    Reading the pane by name skipped him silently, which for a watchdog means the one
    bot it never checks is the CEO's.
    """
    try:
        uid = str(pwd.getpwnam(user).pw_uid)
    except KeyError:
        uid = user
    return run(["podman", "exec", "--interactive", "--user", uid,
                "--env", f"TMUX_TMPDIR={HOME_ROOT}/{user}/.claude",
                f"claude-{user}", *argv], inp=inp)


def pane(user: str) -> str | None:
    """What is on the bot's screen right now, or None if we cannot see it."""
    # -J rejoins what tmux wrapped. Without it a long code comes back as two half-lines
    # and matches nothing, which is the same failure as reading it truncated.
    p = in_pod(user, "tmux", "-u", "capture-pane", "-J", "-p", "-t", TMUX_SESSION)
    return p.stdout if p.returncode == 0 else None


def days_left(user: str) -> float | None:
    """Days until the refresh token dies. None when there is no dated session at all."""
    path = f"{HOME_ROOT}/{user}/.claude/.credentials.json"
    try:
        with open(path, encoding="utf8") as fh:
            blob = json.load(fh)
    except (OSError, ValueError):
        return None
    oauth = blob.get("claudeAiOauth", blob)
    try:
        when = datetime.fromtimestamp(int(oauth["refreshTokenExpiresAt"]) / 1000, timezone.utc)
    except (KeyError, TypeError, ValueError):
        return None
    return (when - datetime.now(timezone.utc)).total_seconds() / 86400


def state_path(user: str) -> str:
    return os.path.join(STATE_DIR, f"{user}.json")


def first_seen(user: str, now: float, present: bool, dry: bool) -> float:
    """Epoch at which this modal first appeared. Forgets it as soon as it is gone."""
    path = state_path(user)
    if not present:
        if not dry:
            try:
                os.unlink(path)
            except OSError:
                pass
        return 0.0
    try:
        with open(path, encoding="utf8") as fh:
            return float(json.load(fh)["since"])
    except (OSError, ValueError, KeyError):
        if not dry:
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf8") as fh:
                json.dump({"since": now, "user": user}, fh)
            os.replace(tmp, path)
        return now


def widen(user: str) -> None:
    """Put the pane back to the size it was created at.

    A support session that attaches at 80 columns and walks away leaves the window that
    size for good, and everything the TUI renders is cut to fit — including the code we
    are trying to read.
    """
    in_pod(user, "tmux", "resize-window", "-t", TMUX_SESSION,
           "-x", str(PANE_COLS), "-y", str(PANE_ROWS))


def queued_code(screen: str) -> tuple[str | None, bool]:
    """The newest sign-in code sitting unread in the pane.

    Returns (code, truncated). `truncated` says a line that was shaped like a code was
    cut off by the pane width — we must NOT type half a credential, so the caller widens
    the pane and looks again rather than guessing at the rest.
    """
    best, truncated = None, False
    for raw in screen.splitlines():
        line = raw.strip()
        if "oauth/authorize" in line:
            continue                       # the modal's own URL, wrapped across lines
        # A queued message is drawn as "← telegram · <chat>: <text>", and the text moves
        # to the line below only when it will not fit beside the prefix. Both shapes
        # carry the same code, so take the body off the prefix when there is one.
        if QUEUED_MARKER in line and ": " in line:
            line = line.split(": ", 1)[1].strip()
        if not line:
            continue
        if line.endswith(ELLIPSIS):
            stem = line[:-1].strip()
            # Enough of a code to recognise, not enough to use.
            if "#" in stem and " " not in stem and len(stem) >= 16:
                truncated = True
            continue
        if CODE_RE.match(line):
            best = line                    # keep going: the last one is the newest
    return best, truncated


def type_code(user: str, code: str) -> bool:
    """Put the code into the modal the way a person would, and say whether it took.

    Through a tmux buffer rather than `send-keys <code>`: a sign-in code is single-use
    but it is a credential until it is spent, and an argument is readable out of /proc
    by anything on the host for as long as the call lasts.
    """
    load = in_pod(user, "tmux", "load-buffer", "-b", "relogin-code", "-", inp=code)
    if load.returncode != 0:
        return False
    in_pod(user, "tmux", "paste-buffer", "-b", "relogin-code", "-t", TMUX_SESSION, "-d")
    in_pod(user, "tmux", "send-keys", "-t", TMUX_SESSION, "Enter")
    # The exchange is a round trip to Anthropic; the helper allows 90 s for it.
    for _ in range(30):
        time.sleep(3)
        after = pane(user) or ""
        if "Login successful" in after:
            in_pod(user, "tmux", "send-keys", "-t", TMUX_SESSION, "Enter")
            return True
        if not any(m in after for m in MODAL_MARKERS):
            return True                    # modal gone: it was accepted
        if "Invalid code" in after or "expired" in after.lower():
            return False
    return False


def clear(user: str) -> bool:
    """Esc, then look again. True when the screen came back."""
    in_pod(user, "tmux", "send-keys", "-t", TMUX_SESSION, "Escape")
    time.sleep(2)
    after = pane(user) or ""
    return not any(m in after for m in MODAL_MARKERS)


def tell_admin(admin: str, text: str) -> bool:
    base = f"{HOME_ROOT}/{admin}/.claude/channels/telegram-{admin}"
    token = ""
    try:
        with open(os.path.join(base, ".env"), encoding="utf8") as fh:
            for line in fh:
                if line.startswith("TELEGRAM_BOT_TOKEN="):
                    token = line.split("=", 1)[1].strip()
        with open(os.path.join(base, "access.json"), encoding="utf8") as fh:
            allow = json.load(fh).get("allowFrom") or []
        chat = str(allow[0]) if allow else ""
    except (OSError, ValueError, IndexError):
        return False
    if not token or not chat:
        return False
    body = urllib.parse.urlencode({"chat_id": chat, "text": text}).encode()
    req = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendMessage", data=body)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return resp.status == 200
    except (urllib.error.URLError, OSError):
        return False


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--only", nargs="*", default=None)
    ap.add_argument("--grace", type=int, default=GRACE_S)
    ap.add_argument("--to", default=DEFAULT_ADMIN)
    args = ap.parse_args()

    if os.geteuid() != 0 and not args.dry_run:
        print("login-modal-watch: run as root", file=sys.stderr)
        return 1

    now = time.time()
    cleared, stuck, handed_over, signed_in = [], [], [], []
    looked = unseen = found = 0
    for user in (args.only or tenants()):
        screen = pane(user)
        if screen is None:
            unseen += 1                   # pod down or no tmux; not our problem
            continue
        looked += 1
        present = any(m in screen for m in MODAL_MARKERS)
        since = first_seen(user, now, present, args.dry_run)
        if not present:
            continue
        found += 1
        waited = int(now - since)
        left = days_left(user)
        queued = QUEUED_MARKER in screen

        # A message queued behind the window removes the only reason to wait. The dwell
        # time is there to avoid interrupting a sign-in somebody is in the middle of;
        # an unread message from the bot's owner proves nobody is.
        grace = 0 if queued else args.grace
        if waited < grace:
            print(f"{user}: sign-in window open {waited}s, key good for "
                  f"{'?' if left is None else format(left, '.1f')}d "
                  f"— waiting until {grace}s before touching it")
            continue

        expired = left is None or left <= 0
        if expired and not queued:
            # Nothing to sign in WITH, and nobody waiting. The window is the cure.
            print(f"{user}: sign-in window open, credentials expired, nothing queued "
                  f"— leaving it alone")
            continue

        # First choice: finish the sign-in the person is already trying to do. They were
        # given a link at the terminal and sent the code to the chat, where it cannot
        # reach the modal — but it IS sitting in the pane, unread, in full, as long as
        # the pane is its proper width. Type it in for them and the thing they did works.
        candidate, truncated = queued_code(screen)
        if not candidate and truncated and not args.dry_run:
            widen(user)
            time.sleep(1)
            screen = pane(user) or screen
            candidate, truncated = queued_code(screen)

        if args.dry_run:
            if candidate:
                what = "type the code waiting in the pane and finish the sign-in"
            elif truncated:
                what = "widen the pane to read a code that is cut off, then type it"
            elif expired:
                what = "end it and hand the sign-in to the chat"
            else:
                what = f"clear it (key good for {left:.1f}d)"
            print(f"{user}: would {what} — window stuck {waited}s"
                  f"{', person waiting behind it' if queued else ''}")
            continue

        if candidate:
            before = left
            if type_code(user, candidate):
                now_left = days_left(user)
                signed_in.append((user, waited, now_left))
                try:
                    os.unlink(state_path(user))
                except OSError:
                    pass
                print(f"{user}: typed the code that was waiting in the chat — signed in, "
                      f"key now good for "
                      f"{'?' if now_left is None else format(now_left, '.1f')}d "
                      f"(was {'none' if before is None else format(before, '.1f') + 'd'})")
                continue
            print(f"{user}: the code waiting in the pane was refused — "
                  f"falling back to a fresh sign-in", file=sys.stderr)
            screen = pane(user) or screen

        if not clear(user):
            stuck.append((user, waited))
            print(f"{user}: sign-in window would not close after {waited}s — needs a person",
                  file=sys.stderr)
            continue

        try:
            os.unlink(state_path(user))
        except OSError:
            pass

        if expired:
            # The terminal route was used and the person answered in the chat, where
            # their code could never land. Their key really is dead, so clearing the
            # window is only half of it: start the route that does take a code from the
            # chat, and they get a working link where they are already looking.
            handed = run([RELOGIN_TRIGGER, user, "--reason", "expired"], timeout=120)
            ok = handed.returncode == 0
            handed_over.append((user, waited, ok))
            print(f"{user}: ended a dead sign-in window stuck {waited}s and "
                  f"{'sent them a working link in their chat' if ok else 'COULD NOT hand over — ' + (handed.stderr.strip() or 'see relogin-trigger')}")
        else:
            cleared.append((user, waited, left))
            print(f"{user}: cleared a sign-in window stuck {waited}s "
                  f"(key good for {left:.1f}d) — the bot can hear again")

    # Always say what was looked at. A watchdog that prints nothing when it found
    # nothing is indistinguishable from a watchdog that did not run, and this whole
    # file exists because something failed quietly for months.
    print(f"looked at {looked} bot(s), {unseen} unreachable, "
          f"{found} showing a sign-in window, {len(cleared)} cleared")

    if cleared or stuck or handed_over or signed_in:
        lines = ["Bots that were stuck behind a sign-in window:"]
        for user, waited, left in cleared:
            lines.append(f"• {user} — deaf for {waited // 60} min with a valid key "
                         f"({left:.0f} days left). Window closed, it is answering again.")
        for user, waited, now_left in signed_in:
            lines.append(f"• {user} — a sign-in was opened at the terminal and the code "
                         f"came back by chat, where it could not land. Deaf "
                         f"{waited // 60} min. I typed it in; they are signed in"
                         + (f" for another {now_left:.0f} days." if now_left else "."))
        for user, waited, ok in handed_over:
            lines.append(f"• {user} — a sign-in was opened at the terminal and their key "
                         f"had run out, so the code they sent in chat could not land. "
                         f"Deaf {waited // 60} min. Window ended and "
                         + ("a working link sent to their chat."
                            if ok else "the hand-over FAILED — they need you."))
        for user, waited in stuck:
            lines.append(f"• {user} — deaf for {waited // 60} min and the window would "
                         f"not close. Needs looking at.")
        lines.append("")
        lines.append("A /login window in a bot's own terminal blocks everything behind it, "
                     "and no other check sees it.")
        tell_admin(args.to, "\n".join(lines))
    return 0


if __name__ == "__main__":
    sys.exit(main())
