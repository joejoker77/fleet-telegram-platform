#!/usr/bin/env python3
"""Turn Pipedrive's 40-character field hashes into names, and back.

    field-map limitation              # any field whose name matches
    field-map 4ceb2fc303398f69863211768365e618cf54548b   # what is this hash
    field-map --entity person email
    field-map --all                   # every custom field on deals
    field-map --options <key|name>    # the allowed values of an enum field
    field-map --tables                # the Supabase tables, for cross-checking
    field-map --json

Pipedrive holds 311 fields on a deal and 254 of them are named by hash, so a
raw export is unreadable and a filter written against the wrong hash returns
a confident, empty answer. This resolves both directions.

Enum fields are the trap worth knowing about: the API stores the option *id*,
not the label, so filtering on the human word silently matches nothing. Use
--options to get the ids.

Reads only, calls no model, safe to schedule.
"""
import argparse
import json
import re
import sys
import urllib.error
import urllib.request

PD = "https://monacosolicitors2.pipedrive.com/api/v1"
SUPABASE = "https://jdjxlczkggckdnpeluuw.supabase.co/rest/v1/"
ENTITIES = {
    "deal": "dealFields", "person": "personFields",
    "org": "organizationFields", "activity": "activityFields",
    "product": "productFields",
}
HASH = re.compile(r"^[0-9a-f]{40}$")


def get(url):
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def fields(entity):
    d = get(f"{PD}/{ENTITIES[entity]}?limit=500")
    if not d.get("success", True):
        raise SystemExit(f"Pipedrive said no: {str(d)[:200]}")
    return d.get("data") or []


def matches(rows, term):
    if not term:
        return rows
    t = term.lower()
    if HASH.match(t):
        return [f for f in rows if f.get("key", "").lower() == t]
    return [f for f in rows if t in (f.get("name") or "").lower()
            or t in (f.get("key") or "").lower()]


def render(rows, show_all):
    if not rows:
        return "No field matches that."
    out = []
    for f in sorted(rows, key=lambda x: (x.get("name") or "").lower()):
        key, name = f.get("key", ""), f.get("name", "")
        kind = f.get("field_type", "")
        custom = "" if len(key) != 40 else "  [custom]"
        out.append(f"{key:42} {kind:14} {name}{custom}")
        opts = f.get("options") or []
        if opts and (show_all or len(rows) <= 3):
            for o in opts[:40]:
                out.append(f"{'':42} {'':14}   {o.get('id')} = {o.get('label')}")
            if len(opts) > 40:
                out.append(f"{'':42} {'':14}   ... {len(opts) - 40} more options, "
                           f"use --options for the full list")
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("term", nargs="?", help="field name fragment, or a 40-hex key")
    ap.add_argument("--entity", choices=sorted(ENTITIES), default="deal")
    ap.add_argument("--all", action="store_true", help="every field, not just custom")
    ap.add_argument("--options", metavar="FIELD", help="list an enum field's option ids")
    ap.add_argument("--tables", action="store_true", help="list the Supabase tables")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    if a.tables:
        d = get(SUPABASE)
        names = sorted(p.lstrip("/") for p in (d.get("paths") or {})
                       if p not in ("/",) and not p.startswith("/rpc"))
        if a.json:
            print(json.dumps(names, indent=1))
        else:
            print(f"{len(names)} tables on the case database:")
            for n in names:
                print("  " + n)
        return

    try:
        rows = fields(a.entity)
    except (urllib.error.URLError, OSError, ValueError) as e:
        sys.exit(f"Could not read Pipedrive fields: {e}")

    if a.options:
        hit = matches(rows, a.options)
        if not hit:
            sys.exit(f"No {a.entity} field matches '{a.options}'.")
        for f in hit:
            opts = f.get("options") or []
            print(f"{f['name']}  ({f['key']}, {f.get('field_type')})")
            if not opts:
                print("  not an enum, it has no option list.")
            for o in opts:
                print(f"  {o.get('id')} = {o.get('label')}")
        return

    hit = matches(rows, a.term)
    if not a.all and not a.term:
        hit = [f for f in hit if len(f.get("key", "")) == 40]

    if a.json:
        print(json.dumps(hit, indent=1))
        return
    total = len(rows)
    custom = sum(1 for f in rows if len(f.get("key", "")) == 40)
    print(f"{a.entity}: {total} fields, {custom} custom. Showing {len(hit)}.\n")
    print(render(hit, a.all))


if __name__ == "__main__":
    main()
