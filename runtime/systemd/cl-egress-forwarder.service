[Unit]
Description=cl-egress forwarder (tenant bridge gateway -> OneCLI proxy)
Wants=network-online.target
After=network-online.target

[Service]
# GW is the cl-net gateway IP, written to /etc/cl-egress.env by m2.3-egress.sh
# (cl-net's subnet is podman-assigned to avoid collisions). Listen on the
# gateway and forward to the host-loopback OneCLI proxy, so tenant containers
# reach the proxy without the shared OneCLI being reconfigured.
EnvironmentFile=/etc/cl-egress.env
ExecStart=/usr/bin/socat TCP-LISTEN:10255,bind=${GW},fork,reuseaddr TCP:127.0.0.1:10255
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
