# M5.5b — per-connection instance of the cp-secretd helper (Accept=yes).
# stdin/stdout are the accepted connection; the helper reads one JSON request,
# answers, exits. HOME=/root is REQUIRED: onecli reads its stored API key from
# $HOME (silent-auth-failure incident 2026-05-29).
# AUDIT_SOCK is appended by the installer (resolved cp-audit-run volume path).
[Unit]
Description=cp-secretd request handler (%i)

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cp-secretd
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=HOME=/root
TimeoutStartSec=90
