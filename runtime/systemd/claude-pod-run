#!/usr/bin/env bash
# Launch one tenant's runtime container. Invoked by claude-pod@.service as:
#   claude-pod-run <username>
#
# Hardening (pilot interim): rootful podman + run-as-tenant-uid (--user) so
# mounted home keeps host ownership, + --init (tini PID1 → signals work & reaping),
# --cap-drop=ALL, --security-opt=no-new-privileges, --read-only rootfs + tmpfs,
# and podman-enforced mem/cpu/pids limits (authoritative; the unit's cgroup
# limits are a backstop). NETWORK is default bridge here — the locked netns +
# nftables egress default-deny lands in M2.3. Fully-rootless per-user podman
# (--userns=keep-id, own image store) is the hardening TARGET; deferred to keep
# this step low-risk (see project_fleet_rearchitecture / ADR notes).
set -euo pipefail

U="${1:?usage: claude-pod-run <username>}"
id "$U" >/dev/null 2>&1 || { echo "no such user: $U"; exit 1; }
UID_N="$(id -u "$U")"
GID_N="$(id -g "$U")"
HOME_DIR="/home/$U"
IMAGE="localhost/claude-user:latest"

podman image exists "$IMAGE" || { echo "image $IMAGE missing (run m2.1-build-image.sh)"; exit 1; }
[ -d "$HOME_DIR/.claude" ] || { echo "$HOME_DIR/.claude missing"; exit 1; }
[ -d "$HOME_DIR/work" ] || { echo "$HOME_DIR/work missing"; exit 1; }

# Network: use the locked egress bridge cl-net once M2.3 has provisioned it
# (egress default-deny via nftables; reach the OneCLI proxy at the gateway).
# Falls back transparently to the default bridge pre-M2.3 / after rollback.
PROXY_ARGS=()
if podman network exists cl-net >/dev/null 2>&1; then
  NETWORK=cl-net
  # cl-net's subnet/gateway are podman-assigned (collision-free); read the
  # gateway so the container points its proxy at it. Per-tenant proxy auth token
  # is injected by the provisioner at M2.6; the network path is what the egress
  # lockdown enforces now.
  GW="$(podman network inspect cl-net --format json 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["subnets"][0]["gateway"])' 2>/dev/null || true)"
  if [ -n "${GW:-}" ]; then
    # Per-tenant OneCLI scoped proxy token (provisioned at M2.4/M2.6). When present,
    # the agent authenticates to the proxy as itself (selective secrets, isolation).
    AUTH=""
    TOKEN_FILE="/etc/cl-egress/$U.token"
    [ -f "$TOKEN_FILE" ] && AUTH="x:$(cat "$TOKEN_FILE")@"
    PROXY_ARGS=(-e HTTPS_PROXY="http://${AUTH}${GW}:10255" -e HTTP_PROXY="http://${AUTH}${GW}:10255" -e NO_PROXY="127.0.0.1,localhost,::1")
    # OneCLI is a TLS-intercepting proxy — clients must trust its CA bundle,
    # else the CONNECT tunnel opens but TLS fails. Mount the host CA + point the
    # standard CA-trust env vars (curl/node/python) at it.
    CA=/etc/onecli/ca-bundle.pem
    if [ -f "$CA" ]; then
      PROXY_ARGS+=(-v "$CA:$CA:ro" \
        -e NODE_EXTRA_CA_CERTS="$CA" -e SSL_CERT_FILE="$CA" \
        -e REQUESTS_CA_BUNDLE="$CA" -e CURL_CA_BUNDLE="$CA")
    fi
  fi
else
  NETWORK=podman
fi

# Claude Code's top-level config (~/.claude.json: onboarding/trust state) lives
# in HOME, NOT under ~/.claude — without it Claude treats the run as first-run
# and exits in a non-interactive pane. Mount it when present.
CFG_ARGS=()
[ -f "$HOME_DIR/.claude.json" ] && CFG_ARGS+=(-v "$HOME_DIR/.claude.json:$HOME_DIR/.claude.json")

# Claude subscription auth: per-tenant long-lived OAuth token (CLAUDE_CODE_OAUTH_TOKEN
# from `claude setup-token`), injected as env so the pod's claude authenticates
# HEADLESSLY — no browser on the box, no shared credentials.json (per-seat, ToS).
# Host-only file (mirrors the /etc/cl-egress proxy-token pattern); takes precedence
# over a mounted ~/.claude/.credentials.json. Without any auth the claude session
# can't start and the supervisor restart-loops.
CLAUDE_AUTH_ARGS=()
CLAUDE_TOKEN_FILE="/etc/claude-auth/$U.token"
[ -f "$CLAUDE_TOKEN_FILE" ] && CLAUDE_AUTH_ARGS=(-e CLAUDE_CODE_OAUTH_TOKEN="$(cat "$CLAUDE_TOKEN_FILE")")

# ~/.ssh: mount the tenant's own SSH keys so the agent can reach remote servers
# (owner decision 2026-06-15; egress is full-outbound). Mounted rw so ssh can
# append to ~/.ssh/known_hosts on first connect. Only when present — users with
# no keys are unaffected. Perms must already be ssh-correct on the host (~/.ssh
# 700, private keys 600, tenant-owned); the pod runs as the tenant uid (--user)
# so ownership carries over and ssh accepts the keys.
SSH_ARGS=()
[ -d "$HOME_DIR/.ssh" ] && SSH_ARGS+=(-v "$HOME_DIR/.ssh:$HOME_DIR/.ssh")

# ~/icloud: if the tenant has an active iCloud FUSE mount on the host, propagate
# it INTO the pod. The rclone mount lives on the HOST (rclone-<user>-mount /
# rclone-icloud-mount@<user>; --allow-other + --uid/--gid <tenant> so the pod uid
# can read it). FUSE inside the pod would need SYS_ADMIN and break the hardening,
# so we bind the host mountpoint with :rslave. Make the source rshared first so
# rclone REMOUNTS (e.g. its own restart) propagate into the running container.
# No-op for users without iCloud (most). See docs/12.
ICLOUD_ARGS=()
if mountpoint -q "$HOME_DIR/icloud" 2>/dev/null; then
  mount --make-rshared "$HOME_DIR/icloud" 2>/dev/null || true
  ICLOUD_ARGS=(-v "$HOME_DIR/icloud:$HOME_DIR/icloud:rslave")
fi

# ~/.config must be a mounted volume: the pod rootfs is --read-only, and the
# entrypoint's M4.1 shellfirm seed writes ~/.config/shellfirm/settings.yaml.
# Without the mount the mkdir hits the RO overlay and the entrypoint dies
# (2026-06-10 incident: claude-pod@vitaliy failed to start). Pre-create it
# owned by the tenant — podman would otherwise create a missing host dir as
# root and the in-container user couldn't write it either.
install -d -o "$UID_N" -g "$GID_N" -m 0755 "$HOME_DIR/.config"

# ~/.local — same RO-rootfs class of bug (2026-06-11, M5.6): code-server keeps
# its user state in ~/.local/share/code-server (extensions.json, User settings,
# workspaceStorage, caches). Without the mount every write EROFSes: built-in
# extensions (git, emmet, merge-conflict…) fail to activate and nothing the
# user configures in the IDE persists.
install -d -o "$UID_N" -g "$GID_N" -m 0755 "$HOME_DIR/.local"

# Audit wiring: share the control-plane audit-collector socket (named volume
# cp-audit-run, created by m1.5; the collector + cp-api mount the same volume). The
# collector owns the socket root:audit 0660, so the tenant joins the `audit` group
# for WRITE-ONLY access (never read/mutate the WORM dir). The metering Stop hook +
# the entrypoint's runtime.start emit best-effort events to /run/audit/collector.sock.
# Conditional on the volume existing so the pod still starts pre-audit / after a
# control-plane teardown (mirrors the cl-net fallback above). The audit gid is
# resolved BY NAME on the host at run time → portable across servers.
AUDIT_ARGS=()
if podman volume exists cp-audit-run >/dev/null 2>&1; then
  AUDIT_ARGS=(-v cp-audit-run:/run/audit)
  AGID="$(getent group audit 2>/dev/null | cut -d: -f3 || true)"
  [ -n "${AGID:-}" ] && AUDIT_ARGS+=(--group-add "$AGID")
fi

# M5.6 web-IDE: expose code-server over a unix socket bind-mounted to the host
# so nginx (forward-auth vhost, deploy/nginx-ide.conf) reaches it without ANY
# network exposure — not on cl-net, not on host ports; a neighbor pod physically
# can't connect. Conditional on /run/cp-ide existing (created by m5.6-ide.sh via
# tmpfiles.d; absent — e.g. after m5.6-rollback.sh — → prior tcp-loopback
# behavior), mirroring the cl-net/audit fallbacks above. The per-tenant dir is
# setgid www-data (2750): the socket code-server creates inherits the group, so
# nginx connects via socket-mode 0660 while the dir stays tenant-owned.
IDE_ARGS=()
if [ -d /run/cp-ide ]; then
  WGID="$(getent group www-data 2>/dev/null | cut -d: -f3 || true)"
  if [ -n "${WGID:-}" ]; then
    install -d -o "$UID_N" -g "$WGID" -m 2750 "/run/cp-ide/$U"
    IDE_ARGS=(-v "/run/cp-ide/$U:/run/cp-ide" -e CP_IDE_SOCKET=/run/cp-ide/ide.sock)
  fi
fi

exec /usr/bin/podman run --rm --name "claude-$U" \
  --init \
  --user "${UID_N}:${GID_N}" \
  --network "$NETWORK" \
  --cap-drop=ALL --security-opt=no-new-privileges \
  --read-only --tmpfs /tmp --tmpfs /run \
  --memory=4g --memory-reservation=3g --cpus=2 --pids-limit=2048 \
  -e HOME="$HOME_DIR" -e XDG_RUNTIME_DIR=/tmp -e HOST_ADMIN_USER="$U" "${PROXY_ARGS[@]}" "${CLAUDE_AUTH_ARGS[@]}" \
  -v "$HOME_DIR/.claude:$HOME_DIR/.claude" \
  -v "$HOME_DIR/work:$HOME_DIR/work" \
  -v "$HOME_DIR/.config:$HOME_DIR/.config" \
  -v "$HOME_DIR/.local:$HOME_DIR/.local" \
  "${CFG_ARGS[@]}" "${SSH_ARGS[@]}" "${ICLOUD_ARGS[@]}" "${AUDIT_ARGS[@]}" "${IDE_ARGS[@]}" \
  -w "$HOME_DIR/work" \
  "$IMAGE"
