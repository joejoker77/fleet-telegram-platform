[Unit]
Description=Report Claude sign-ins that are about to lapse (to the firm admin, over Telegram)
Documentation=file:///opt/ftp-src/fleet-telegram-platform/runtime/install/login-expiry-notify.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/login-expiry-notify
# It reads one integer per tenant out of ~/.claude/.credentials.json, so it needs to see
# the homes — read-only is enough. The only thing it writes is its own state file, which
# is what keeps it from repeating itself every morning.
# Hardening is deliberately light, for the same reason as relogin-web.service (commit
# 888cbd6): since 6 Oct this service does not only report to an administrator, it also
# runs relogin-trigger, which drives `podman inspect` and `podman exec` against a
# tenant's pod. Under ProtectSystem=strict + PrivateTmp=true podman cannot see the
# container store, every pod reads as stopped, and the sign-in link is never sent — the
# failure is silent, because the admin report goes out regardless. It cost five people
# their warning on 7 Oct, two of them already expired. Do not re-add those two.
ProtectHome=read-only
StateDirectory=fleet
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
# Network stays on: the whole job is one call to api.telegram.org.
TimeoutStartSec=120
