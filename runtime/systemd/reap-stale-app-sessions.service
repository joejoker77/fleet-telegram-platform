[Unit]
Description=End abandoned Claude App sessions in tenant pods (memory reclaim)
Documentation=file:///opt/ftp-src/fleet-telegram-platform/runtime/install/reap-stale-app-sessions.sh
# Nothing to wait for: it only reads /proc and signals processes.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/reap-stale-app-sessions --idle-hours 48
# It signals processes owned by tenants, so it needs to stay root; everything else is
# tightened. No network. It reads tenants' transcripts (read-only) to tell a live
# conversation from an abandoned one, and writes exactly one file: its two-strike state
# under /var/lib/fleet.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fleet
StateDirectory=fleet
PrivateTmp=true
PrivateNetwork=true
NoNewPrivileges=true
# /proc must stay visible in full — the script reads other users' cmdlines to tell an
# App session from the Telegram bot, and hidepid/subset would hide exactly that.
ProcSubset=all
ProtectProc=default
# It sleeps ~90s between CPU samples, then up to 25s for TERM to land.
TimeoutStartSec=600
