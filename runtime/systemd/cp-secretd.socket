# M5.5b — socket activation for the cp-secretd privileged helper.
# No long-running process, no timer, no LLM: an instance spawns per connection
# (Accept=yes) and exits after one request/response.
# The socket dir /run/cp-secretd is bind-mounted into cp-api (m1.5).
[Unit]
Description=cp-secretd (OneCLI secret intake for the MCP gate) — activation socket

[Socket]
ListenStream=/run/cp-secretd/secretd.sock
Accept=yes
SocketMode=0660
SocketUser=root
SocketGroup=cp-secret
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
