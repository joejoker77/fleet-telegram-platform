[Unit]
Description=cl-grapple forwarder (tenant bridge gateway -> Grapple read-only replica gateway)
Wants=network-online.target
After=network-online.target

[Service]
# Same shape as cl-dbread-forwarder, one port along. GW is the cl-net gateway IP from
# /etc/cl-egress.env. Tenant pods cannot reach a service on the host's loopback, so
# listen on the bridge gateway and forward to the gateway container's 127.0.0.1:8093.
# Paired with an nft rule allowing the pod subnet to reach tcp/10258 on the host
# (m9.2-grapple-replica-gateway.sh installs both).
EnvironmentFile=/etc/cl-egress.env
ExecStart=/usr/bin/socat TCP-LISTEN:10258,bind=${GW},fork,reuseaddr TCP:127.0.0.1:8093
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
