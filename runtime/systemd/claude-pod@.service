[Unit]
Description=Claude tenant runtime container (%i)
Wants=network-online.target
After=network-online.target
# Rate-limit restarts so the entrypoint's liveness-watchdog (which exits → Restart
# when the Telegram channel can't come up) cannot hot-loop on a permanently-broken
# channel — e.g. a revoked bot token. After StartLimitBurst restart cycles inside
# StartLimitIntervalSec, systemd holds the unit in 'failed' (manual `systemctl
# reset-failed && start` to revive). Window is wide enough that the watchdog's
# normal ~150s startup-grace cycles don't trip it during healthy operation.
StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
Type=simple
# Clean any stale container from a previous run, then launch via the wrapper
# (resolves the tenant uid and applies the hardening flags).
ExecStartPre=-/usr/bin/podman rm -f claude-%i
ExecStart=/usr/local/sbin/claude-pod-run %i
ExecStop=/usr/bin/podman stop -t 20 claude-%i
Restart=always
RestartSec=20
TimeoutStopSec=30

# cgroup backstop (authoritative limits are podman --memory/--cpus in the wrapper)
MemoryAccounting=true
MemoryHigh=3G
MemoryMax=4G
CPUWeight=100
IOWeight=100
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
