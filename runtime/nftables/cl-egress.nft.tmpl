#!/usr/sbin/nft -f
# M2.3 template — egress lockdown for tenant containers on cl-net.
# __SUBNET__ / __GW__ are substituted at install time with cl-net's
# podman-assigned values (auto-picked to avoid host subnet collisions).
#
# Own table (inet cl_egress) so it NEVER edits existing perimeter rules;
# rollback = `nft delete table inet cl_egress`. Priority -10 so the explicit
# drops win; non-tenant traffic falls through (policy accept) untouched.

add table inet cl_egress
delete table inet cl_egress
table inet cl_egress {
  chain forward {
    type filter hook forward priority -10; policy accept;
    # FULL OUTBOUND (2026-06-15, owner decision): agents must reach remote servers
    # (ssh, rsync, package installs, third-party APIs) or they're crippled for
    # devops/debugging. HTTP/HTTPS still routes through the OneCLI proxy via the
    # pod's HTTPS_PROXY env (secret injection + audit preserved for those tools);
    # ssh and other protocols go direct. The `input` chain below still confines
    # container->HOST traffic to the proxy port only, so host services stay closed.
    # To re-lock egress, restore the prior drop rule (see git history).
    ip saddr __SUBNET__ counter accept
  }
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr __SUBNET__ ct state established,related counter accept
    ip saddr __SUBNET__ tcp dport 10255 counter accept
    ip saddr __SUBNET__ counter drop
  }
}
