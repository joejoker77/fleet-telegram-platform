#!/usr/sbin/nft -f
# M2.3 — egress lockdown for tenant containers on the cl-net bridge (10.89.0.0/24).
#
# Lives in its OWN table (inet cl_egress) so it NEVER edits existing perimeter
# rules — rollback is simply `nft delete table inet cl_egress`. Hooks at priority
# -10 (before podman's accept rules) so the explicit drops win; non-tenant
# traffic falls through (policy accept) to the existing tables untouched.
#
# Allowed for a tenant container: established/related, and TCP to the gateway
# (10.89.0.1) port 10255 — the per-tenant forwarder → OneCLI proxy. Everything
# else (direct internet, other host ports, DNS) is dropped. The container needs
# no DNS: it talks only to the proxy by IP; the proxy resolves upstreams host-side.

add table inet cl_egress
delete table inet cl_egress
table inet cl_egress {
  chain forward {
    type filter hook forward priority -10; policy accept;
    ip saddr 10.89.0.0/24 ct state established,related accept
    ip saddr 10.89.0.0/24 ip daddr 10.89.0.1 accept
    ip saddr 10.89.0.0/24 drop
  }
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr 10.89.0.0/24 ct state established,related accept
    ip saddr 10.89.0.0/24 tcp dport 10255 accept
    ip saddr 10.89.0.0/24 drop
  }
}
