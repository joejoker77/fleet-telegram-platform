# Claude tenant tmux pane dumps (added 2026-08-12; tightened 2026-10-27).
# copytruncate: tmux pipe-pane holds the fd open; renaming would orphan the writer.
#
# The old settings were `rotate 7, size 50M, delaycompress`, which let one
# tenant hold ~400MB of pane dumps and put 6.6 GB of them across the fleet.
# delaycompress is pointless with copytruncate -- nothing holds the rotated
# copy open -- so it only kept .1 uncompressed at full size.
# `size` alone, not `daily size`: given both, logrotate says "'size' overrides
# previously specified 'daily'" and the time directive is dead weight. The
# daily logrotate.timer is what makes this a daily check.
/home/*/.claude/channels/telegram-*/logs/claude-pane.log {
    rotate 3
    size 20M
    copytruncate
    compress
    missingok
    notifempty
    nocreate
}

# The sidecars had no rotation at all: they append for the life of the tenant.
/home/*/.claude/channels/telegram-*/logs/session-indexer.log
/home/*/.claude/channels/telegram-*/logs/transcript-exporter.log
/home/*/.claude/channels/telegram-*/logs/progress-sidecar.log {
    rotate 2
    size 10M
    copytruncate
    compress
    missingok
    notifempty
    nocreate
}
