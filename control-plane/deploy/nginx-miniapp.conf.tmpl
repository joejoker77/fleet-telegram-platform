# Telegram Mini App vhost — rendered by runtime/install/m5.9-web-serving.sh.
# __MINIAPP_HOST__ is substituted from PLATFORM_MINIAPP_HOST (or miniapp.<PLATFORM_DOMAIN>).
# certbot --nginx adds the 443 block + HTTP→HTTPS redirect after this lands.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __MINIAPP_HOST__;

    root /var/www/miniapp/dist;
    index index.html;

    # static SPA — client-side routing falls back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must NEVER be heuristically cached (Telegram webview keys a
    # stale copy by URL → old bundle after deploy). Hashed assets are the real
    # versioning; no-cache forces revalidation of the entrypoint only.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # hashed assets are immutable — cache them hard
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # control-plane API (cp-api, 127.0.0.1:8080)
    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;  # long-lived ws connections (/api/live)
        client_max_body_size 2m;
    }

    location ~ /\. {
        deny all;
    }
}
