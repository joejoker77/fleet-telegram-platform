# Web-IDE (code-server) vhost behind forward-auth — rendered by
# runtime/install/m5.9-web-serving.sh. Substituted:
#   __IDE_HOST__ from PLATFORM_IDE_HOST (or ide.<PLATFORM_DOMAIN>)
#   __TENANT__   the tenant whose code-server socket this vhost fronts
# certbot --nginx adds the 443 block (enable http2 there — workbench.js is large).
#
# Auth: every request (incl. ws upgrades) → auth_request → cp-api GET /ide/auth,
# which checks the cp_ide cookie (Redis session) and that it matches the tenant
# below. code-server runs --auth none; the ONLY path to its socket is this vhost.

upstream cp_ide___TENANT__ {
    server unix:/run/cp-ide/__TENANT__/ide.sock;
}

map $http_upgrade $ide_connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __IDE_HOST__;

    location = /_ide_auth {
        internal;
        proxy_pass http://127.0.0.1:8080/ide/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Ide-Tenant __TENANT__;
    }

    # Ticket → cookie login (the URL the Mini App opens).
    location = /api/ide/login {
        proxy_pass http://127.0.0.1:8080/ide/login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        auth_request /_ide_auth;
        proxy_pass http://cp_ide___TENANT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ide_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding gzip;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 64m;
    }
}
