#!/usr/bin/env python3
"""
fleet-skill-gate <skill_dir> <user>   (M4 / WP4 — L5 skill install gate)

Scan a skill directory through the L5 gate before deploy-skills rsyncs it into
~/.claude/skills/. Pure stdlib (deterministic regex + a direct HTTP call to
cp-judge) so it runs inside whatever sandbox deploy-skills has. Exit codes:
  0 = pass (safe to deploy)
  2 = block (judge/deterministic says malicious — do NOT deploy)
  3 = unavail (cp-judge unreachable) — caller keeps status quo
No-op (exit 0) for users outside GATE_USERS (pilot scope).
"""
import hashlib
import json
import os
import re
import sys
import urllib.request
from pathlib import Path

GATE_USERS = {"vitaliy"}
JUDGE_URL = "http://127.0.0.1:8090/judge"
JUDGE_TIMEOUT = 120
TEXT_EXT = (".md", ".js", ".mjs", ".ts", ".json", ".yaml", ".yml", ".txt", ".sh", ".py")
MAX_BYTES = 256 * 1024
CRITICAL_RES = [
    re.compile(r"\.credentials\.json|\.claude\.json|id_rsa|\.aws/credentials|\.netrc", re.I),
    re.compile(r"\b(curl|wget|fetch)\b[^\n|]*\|\s*(bash|sh|zsh|python|node)\b", re.I),
    re.compile(r"\bnc\b[^\n]*-e\b|/dev/tcp/|bash\s+-i\s*>&", re.I),
]


def read_dir(d: Path) -> str:
    parts, budget = [], MAX_BYTES
    for root, dirs, files in os.walk(d):
        dirs[:] = [x for x in dirs if x not in ("node_modules", ".git")]
        for fn in sorted(files):
            if not fn.lower().endswith(TEXT_EXT) or budget <= 0:
                continue
            p = Path(root) / fn
            try:
                txt = p.read_text(errors="replace")[:budget]
            except OSError:
                continue
            budget -= len(txt)
            parts.append(f"# {p}\n{txt}")
    return "\n\n".join(parts)


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: fleet-skill-gate <skill_dir> <user>", file=sys.stderr)
        return 64
    skill_dir, user = Path(sys.argv[1]), sys.argv[2]
    if user not in GATE_USERS:
        return 0
    if not skill_dir.is_dir():
        print(f"no such dir: {skill_dir}", file=sys.stderr)
        return 3
    content = read_dir(skill_dir)
    for rx in CRITICAL_RES:
        if rx.search(content):
            print(f"BLOCK {skill_dir.name}: deterministic critical match")
            return 2
    payload = json.dumps({
        "artifactHash": hashlib.sha256(content.encode()).hexdigest(),
        "kind": "skill",
        "contentRef": "inline:" + content,
        "rulesetVersion": "r1",
        "actor": user,
        "userId": None,
    }).encode()
    req = urllib.request.Request(JUDGE_URL, data=payload,
                                 headers={"content-type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=JUDGE_TIMEOUT) as resp:
            data = json.loads(resp.read().decode())
    except Exception as e:
        print(f"UNAVAIL {skill_dir.name}: judge call failed ({e})")
        return 3
    verdict = data.get("verdict")
    if verdict == "pass":
        print(f"PASS {skill_dir.name}: judge verdict=pass (cacheHit={data.get('cacheHit')})")
        return 0
    if verdict == "fail":
        print(f"BLOCK {skill_dir.name}: judge verdict=fail (sev={data.get('severity')})")
        return 2
    print(f"UNAVAIL {skill_dir.name}: judge verdict={verdict}")
    return 3


if __name__ == "__main__":
    sys.exit(main())
